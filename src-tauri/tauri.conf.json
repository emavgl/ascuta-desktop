{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ascuta",
  "version": "0.1.0",
  "identifier": "com.ascuta.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "ascuta — settings",
        "url": "index.html",
        "width": 520,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
